{
  "name": "skull-king-crew-ledger",
  "version": "1.11.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --web",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:web": "expo export -p web && node scripts/build-pwa.mjs",
    "serve:web": "npx serve dist -l 8080",
    "test": "npm run typecheck && npm run test:scoring && npm run test:stats && npm run test:app-store-screenshots && npm run test:storage && npm run test:backup && npm run test:livesession && npm run test:cloudsync && npm run test:tables && npm run test:responsive && npm run test:support && npm run test:ux && npm run test:xcode-cloud && npm run test:assets && npm run test:branding",
    "typecheck": "tsc --noEmit",
    "test:scoring": "node --import tsx scripts/test-scoring.ts",
    "test:stats": "node --import tsx scripts/test-stats.ts",
    "test:app-store-screenshots": "node --import tsx scripts/test-app-store-screenshots.ts",
    "screenshots:seed": "node --import tsx scripts/app-store-screenshots/seedSimulator.ts",
    "validate:app-store-screenshots": "node --import tsx scripts/app-store-screenshots/validateExports.ts",
    "test:storage": "node --import tsx scripts/test-storage.ts",
    "test:backup": "node --import tsx scripts/test-backup.ts",
    "test:livesession": "node --import tsx scripts/test-livesession.ts",
    "test:cloudsync": "node --import tsx scripts/test-cloudsync.ts",
    "test:tables": "node --import tsx scripts/test-tables.ts",
    "test:responsive": "node --import tsx scripts/test-responsive-layout.ts",
    "test:support": "node --import tsx scripts/test-support.ts",
    "test:ux": "node --import tsx scripts/test-ux.ts",
    "test:xcode-cloud": "node --import tsx scripts/test-xcode-cloud.ts",
    "test:assets": "node --import tsx scripts/test-assets.ts",
    "test:branding": "node --import tsx scripts/test-branding.ts",
    "android": "expo run:android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~54.0.35",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-keep-awake": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "qrcode-generator": "^2.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.11",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
