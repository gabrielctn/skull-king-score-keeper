{
  "expo": {
    "name": "Skull King Score Keeper",
    "slug": "skull-king-scorekeeper",
    "version": "1.9.2",
    "scheme": "skullking",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1722"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gabrielcretin.skullking",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Skull King Score Keeper",
      "shortName": "Skull King Score Keeper",
      "description": "Skull King Score Keeper is an unofficial fan-made scoring app. Works offline.",
      "themeColor": "#0b1722",
      "backgroundColor": "#0b1722",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": ["./plugins/withSkullKingScoreKeeperAppIntents"],
    "experiments": {
      "baseUrl": "/skull-king-score-keeper"
    },
    "extra": {
      "eas": {
        "projectId": "f7a67ac9-2430-4901-86b7-262bc897ddb5"
      }
    }
  }
}
